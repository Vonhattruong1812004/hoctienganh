NODE_ENV=development

DATABASE_URL=postgresql://postgres:18082004@localhost:55432/english_learning
# Dùng khi chạy migration trực tiếp trên cloud database, ví dụ Supabase/Neon.
DIRECT_URL=
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

API_PORT=4100
# Cloud providers thường tự cấp PORT, local có thể để trống.
PORT=
# Cho phép frontend gọi API. Production nên đặt domain web thật, ví dụ:
# CORS_ORIGIN=https://englishpro.vercel.app
CORS_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4100/api

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

# Nguồn nội dung ngoài cho Content Hub
# Datamuse, LanguageTool và Openverse chạy được không cần key.
# Các key dưới đây là tùy chọn, có thì hệ thống tự bật thêm nguồn.
MERRIAM_WEBSTER_LEARNERS_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
