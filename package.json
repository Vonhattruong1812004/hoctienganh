{
  "name": "english-learning-system",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack English learning platform with Next.js, NestJS, PostgreSQL, Prisma, Redis, and Docker.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run free:ports && node scripts/dev.mjs",
    "free:ports": "node scripts/free-dev-ports.mjs 4000 4100",
    "predev:web": "node scripts/free-dev-ports.mjs 4000",
    "dev:web": "npm run dev -w apps/web",
    "predev:api": "node scripts/free-dev-ports.mjs 4100",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w packages/database",
    "db:migrate": "npm run prisma:migrate -w packages/database",
    "db:studio": "npm run prisma:studio -w packages/database",
    "db:seed:sql": "psql \"$DATABASE_URL\" -f thiet_ke_csdl_hoc_tieng_anh.sql",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
